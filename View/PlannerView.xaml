<Window x:Class="TMS_Project.View.PlannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TMS_Project.View" xmlns:ViewModel="clr-namespace:TMS.ViewModel"
        mc:Ignorable="d"
        Title="PlannerView" Height="450" Width="800" WindowState="Maximized">
    <Window.DataContext>
        <ViewModel:PlannerViewModel/>
    </Window.DataContext>

    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Grid Background="#304674" Height="448">

            <TabControl HorizontalAlignment="Left" Width="830">

                <!--HOME TAB-->
                <TabItem Header="Home" FontWeight="Medium" Background="#304674">
                    <Grid Background="#91BAD6">

                        <Rectangle HorizontalAlignment="Left" Height="264" Margin="20,121,0,0" VerticalAlignment="Top" Width="468" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="100" Margin="474,285,0,0" VerticalAlignment="Top" Width="148" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="110" Margin="474,198,0,0" VerticalAlignment="Top" Width="134" Fill="#304674" RadiusX="28.161" RadiusY="28.161"/>
                        <Rectangle HorizontalAlignment="Left" Height="61" Margin="500,224,0,0" VerticalAlignment="Top" Width="96" Fill="WHite" RadiusX="5.238" RadiusY="5.238"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="45,360,729,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="555,360,219,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="362,360,412,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="417,360,357,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="100,360,674,10"/>

                        <!--logo-->
                        <Ellipse HorizontalAlignment="Left" Height="150" Margin="45,158,0,0" VerticalAlignment="Top" Width="200" Fill="DarkBlue"/>
                        <TextBlock HorizontalAlignment="Left" Margin="69,193,0,0" TextWrapping="Wrap" Text="TMS" VerticalAlignment="Top" Foreground="Azure" FontFamily="Times New Roman" FontSize="70" FontWeight="bold"/>

                        <Label Content="Welcome Planner" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="50" Foreground="DarkBlue"/>
                        <!--logs out of the user; may or may not go back to the login page-->
                        <Button Content="Log Out" Command="{Binding LogInViewModel.LogoutCommand}" HorizontalAlignment="Left" Margin="748,383,0,0" VerticalAlignment="Top" Height="27" Width="66" Background="DarkBlue" Foreground="white" FontWeight="Medium" />

                    </Grid>
                </TabItem>

                <!--ORDERS TAB-->
                <TabItem Header="Orders" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6">

                        <!--titles-->
                        <Label Content="Follow-up Orders" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" Foreground="#1E3F66"/>
                        <Label Content="Add Trips" HorizontalAlignment="Left" Margin="330,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" Foreground="#1E3F66"/>
                        <Label Content="Carrier Information" HorizontalAlignment="Left" Margin="539,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" Foreground="#1E3F66"/>

                        <!--orders from the buyer that needs to be completed-->
                        <DataGrid  Margin="10,47,499,94" Name="Orders" Background="Azure" IsReadOnly="False"/>
                        <Button Content="Complete Order" Command="{Binding CompleteOrder}" HorizontalAlignment="Left" Margin="102,341,0,0" VerticalAlignment="Top" Height="34" Width="130" FontWeight="Bold" Foreground="#001233" Background="Azure" FontSize="15"/>

                        <!--adds trip to the orders-->
                        <Grid Background="#304674" Margin="330,47,290,94">

                            <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="Select an order first to add a Trip" VerticalAlignment="Top" Foreground="Azure" FontWeight="Bold" FontStyle="Italic"/>

                            <!--combo box for carrier-->
                            <TextBlock HorizontalAlignment="Center" Margin="0,43,0,0" Text="Choose Carrier" VerticalAlignment="Top" Foreground="AliceBlue"/>
                            <ComboBox HorizontalAlignment="Center" ItemsSource="{Binding CarrierNames}"  SelectedItem ="{Binding SelectedCarrier}" Margin="0,64,0,0" VerticalAlignment="Top" Width="120" x:Name="CarrierName">
                            </ComboBox>

                            <Button Content="Add Carrier" Command="{Binding AddCarrierCommand}" HorizontalAlignment="Center" Margin="0,242,0,0" VerticalAlignment="Top" Background="azure" Width="86"/>
                            <RadioButton Content="Multiple Trip" HorizontalAlignment="Left" Margin="62,128,0,0" VerticalAlignment="Top" Foreground="AliceBlue"/>

                            <!--combo box for carrier - multiple trip-->
                            <TextBlock HorizontalAlignment="Center" Margin="0,163,0,0" Text="Choose Carrier for Another Trip" VerticalAlignment="Top" Foreground="AliceBlue"/>
                            <ComboBox HorizontalAlignment="Center" ItemsSource="{Binding CarrierNames}" SelectedItem ="{Binding AnotherSelectedCarrier}" Margin="0,184,0,0" VerticalAlignment="Top" Width="120" x:Name="CarrierName2">

                            </ComboBox>

                        </Grid>


                        <!--carrier information-->
                        <Grid Background="#304674" Margin="539,47,10,94">
                            <DataGrid ItemsSource="{Binding CarrierData}"  Margin="10,10,10,10"/>

                        </Grid>

                    </Grid>
                </TabItem>

                <!--ACTIVE ORDERS-->
                <TabItem Header="Active Orders" FontWeight="Medium" Background="#304674">
                    <Grid Background="#91BAD6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="69*"/>
                            <ColumnDefinition Width="755*"/>
                        </Grid.ColumnDefinitions>

                        <!--datagrid for the current status of the completed orders being delivered-->
                        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,10,10,10" Grid.ColumnSpan="2"/>

                    </Grid>
                </TabItem>

                <!--SUMMARY REPORTS for INVOICE DATAS-->
                <TabItem Header="Invoice" FontWeight="Medium" Background="#304674">
                    <Grid Background="#91BAD6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="95*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Generate Invoice Summary Reports" HorizontalAlignment="Left" Margin="20,17,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" Foreground="#1E3F66" Grid.ColumnSpan="2"/>
                        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="20,54,20,99" Grid.ColumnSpan="2"/>

                        <!--buttons for generating summary reports-->
                        <TextBlock HorizontalAlignment="Left" Margin="130,381,0,0" Text="All Time Summary Report" VerticalAlignment="Top" Foreground="Azure" FontWeight="Medium" Grid.Column="1"/>
                        <Button Content="All Time" HorizontalAlignment="Left" Margin="136,337,0,0" VerticalAlignment="Top" Background="azure" FontSize="15" Height="39" Width="129" FontWeight="Bold" Grid.Column="1"/>
                        <TextBlock HorizontalAlignment="Left" Margin="402,381,0,0" Text="Two Weeks Time Summary Report" VerticalAlignment="Top" Foreground="Azure" FontWeight="Medium" Grid.Column="1"/>
                        <Button Content="Two Weeks Time" HorizontalAlignment="Right" Margin="0,337,200,0" VerticalAlignment="Top" Background="azure" FontSize="15" Height="39" Width="129" FontWeight="Bold" Grid.Column="1"/>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Viewbox>
</Window>
