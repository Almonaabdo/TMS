<Window x:Class="TMS_Project.View.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:TMS_Project.ViewModel"
        mc:Ignorable="d"
        Title="AdminView" Height="450" Width="800" WindowState="Maximized">

    <Window.DataContext>
        <viewModel:AdminViewModel />
    </Window.DataContext>

    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Grid Background="#304674" Width="887" Height="482">
            <TabControl>

                <!--HOME TAB-->
                <TabItem Header="Home" FontWeight="Medium" Background="#304674">
                    <Grid Background="#91BAD6" Height="457">

                        <Label Content="Welcome Admin" HorizontalAlignment="Center" Margin="0,10,0,0"
                       VerticalAlignment="Top" FontWeight="Bold" FontSize="50" Foreground="DarkBlue"/>

                        <!--design-->
                        <Rectangle HorizontalAlignment="Left" Height="264" Margin="20,158,0,0" VerticalAlignment="Top" Width="468" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="100" Margin="474,322,0,0" VerticalAlignment="Top" Width="148" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="111" Margin="474,235,0,0" VerticalAlignment="Top" Width="134" Fill="#304674" RadiusX="28.161" RadiusY="28.161"/>
                        <Rectangle HorizontalAlignment="Left" Height="61" Margin="500,261,0,0" VerticalAlignment="Top" Width="96" Fill="WHite" RadiusX="5.238" RadiusY="5.238"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="45,397,786,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="564,397,267,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="360,397,471,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="415,397,416,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="100,397,731,10"/>

                        <!--logs out of the user; may or may not go back to the login page-->
                        <Button Content="Log Out" Command="{Binding LogInViewModel.LogoutCommand}" HorizontalAlignment="Left"
                        Margin="805,420,0,0" VerticalAlignment="Top" Height="27" Width="66"
                        Background="DarkBlue" Foreground="white" FontWeight="Medium" />

                        <!--logo-->
                        <Ellipse HorizontalAlignment="Left" Height="150" Margin="45,188,0,0" VerticalAlignment="Top" Width="200" Fill="DarkBlue"/>
                        <TextBlock HorizontalAlignment="Left" Margin="69,223,0,0" TextWrapping="Wrap" Text="TMS" VerticalAlignment="Top" Foreground="Azure" FontFamily="Times New Roman" FontSize="70" FontWeight="bold"/>


                    </Grid>
                </TabItem>

                <!--CONFIGURATIONS TAB-->
                <TabItem Header="Configurations" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160*"/>
                            <ColumnDefinition Width="12*"/>
                            <ColumnDefinition Width="709*"/>
                        </Grid.ColumnDefinitions>
                        <TabControl Margin="10,10,10,10" Grid.ColumnSpan="3">

                            <!-- Log Files Tab -->
                            <TabItem Header="Log Files" Background="#304674">
                                <Grid Background="#304674">

                                    <!--log files-->
                                    <ListBox Name="LogFiles" ItemsSource="{Binding FileViewModel.LogFiles}"
                                     SelectedItem="{Binding FileViewModel.SelectedLogFile}"
                                     Margin="10,10,10,80" />
                                    <Button Content="Open File"
                                    Command="{Binding FileViewModel.OpenSelectedFileCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Height="38" Width="144" FontWeight="Bold" Foreground="#001233"
                                    Background="Azure" Margin="0,0,170,25" />

                                    <Label Content="Open selected file" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" FontWeight="Medium" Foreground="#b2cbde"
                                   Margin="559,375,0,0" />
                                    <Button Content="Load Files"
                                        Command="{Binding FileViewModel.OpenFileBrowserCommand}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Height="38" Width="144" FontWeight="Bold" Foreground="#001233"
                                        Background="Azure" Margin="170,0,0,25" />
                                    <Label Content="Load log files" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" FontWeight="Medium" Foreground="#b2cbde"
                                        Margin="201,375,0,0" />
                                </Grid>
                            </TabItem>

                            <!-- Backup Files Tab -->
                            <TabItem Header="Backup Files" Background="#304674">
                                <Grid Background="#304674">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16*"/>
                                        <ColumnDefinition Width="13*"/>
                                        <ColumnDefinition Width="826*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ProgressBar -->

                                    <ListBox ItemsSource="{Binding FileViewModel.BackupFiles}" Margin="10,10,10,80"
                                     SelectedItem="{Binding FileViewModel.SelectedBackupFile}" Grid.ColumnSpan="3" />
                                    <Button Content="Open" Command="{Binding FileViewModel.OpenSelectedBackupCommand}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Height="38" Width="144" FontWeight="Bold" Foreground="#001233"
                                    Background="Azure" Margin="141,0,0,25" Grid.Column="2" />
                                    <Label Content="Perform backup operation" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" FontWeight="Medium"
                                   Foreground="#b2cbde" Margin="0,375,163,0" Grid.Column="2" />
                                    <Button Content="Backup" Command="{Binding FileViewModel.BackUpDbCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Height="38" Width="144"
                                    FontWeight="Bold" Foreground="#001233" Background="Azure"
                                    Margin="0,0,170,25" Grid.Column="2" />
                                    <Label Content="Open selected file" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" FontWeight="Medium" Foreground="#b2cbde"
                                   Margin="159,375,0,0" Grid.Column="2" />
                                    <ProgressBar x:Name="ProgressBar" Foreground="SeaGreen"
                                         Visibility="{Binding FileViewModel.ProgressBarVisibility, Mode=OneWay}"
                                         Margin="323,354,0,0" Height="20"
                                         Value="{Binding FileViewModel.BackUpProgress, Mode=OneWay}"
                                         Width="150"
                                         VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!--ALTER DATA TAB-->
                <TabItem Header="Alter Data" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6" Height="485">
                        <TabControl Margin="10,10,10,37">

                            <!-- Route Tab -->
                            <TabItem Header="Route" Background="#304674">
                                <Grid Background="#304674">
                                    <DataGrid Name="RouteTable" ItemsSource="{Binding RouteData}" Background="Azure"
                                              IsReadOnly="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Top"
                                              Width="446" Height="349" Margin="0,16,0,0"/>
                                    <Button Content="Save Changes" Command="{Binding SaveRoutesCommand}" Height="30" Width="109"
                                            Background="Azure" FontWeight="Bold" FontSize="15"
                                            VerticalAlignment="Top" HorizontalAlignment="Center"
                                            Margin="0,370,0,0"/>
                                </Grid>
                            </TabItem>



                            <!-- Rates Tab -->
                            <TabItem Header="Rate" Background="#304674">
                                <Grid Background="#304674">
                                    <DataGrid ItemsSource="{Binding RatesData}" Name="RateFeeTable" Background="Azure"
                                      IsReadOnly="False" Margin="10,10,10,66" />
                                    <Button Content="Save" Command="{Binding SaveRatesCommand}" Height="31" Width="98"
                                    Background="Azure" FontWeight="Bold" FontSize="15" Margin="378,369,379,10" />
                                </Grid>
                            </TabItem>

                            <!-- Carrier Tab -->
                            <TabItem Header="Carrier" Background="#304674">
                                <Grid Background="#304674">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="109*" />
                                        <ColumnDefinition Width="679*" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid ItemsSource="{Binding CarrierViewModel.CarrierData}"
                                      Background="Azure" CanUserAddRows="False" HorizontalAlignment="Left" VerticalAlignment="Top" IsReadOnly="False" Grid.Column="1" Height="278" Width="519" Margin="50,40,0,0" />

                                    <Button Content="Save" Command="{Binding CarrierViewModel.SaveCarrierCommand}"
                                    Height="31" Width="98" Background="Azure" FontWeight="Bold" FontSize="15"
                                    Grid.Column="1" Margin="261,369,378,10" />
                                </Grid>
                            </TabItem>

                            <!-- Delete Tab -->
                            <TabItem Header="Delete Data" Background="#304674">
                                <Grid Background="#304674">
                                    <StackPanel>
                                        <Label Content="Select a table to delete from:" FontWeight="Bold"
                                               Foreground="#b2cbde"
                                               HorizontalAlignment="Center" Margin="0,0,0,5" FontSize="20"/>
                                        <ComboBox ItemsSource="{Binding DeleteViewModel.DeleteOptions}"
                                                  SelectedItem="{Binding DeleteViewModel.SelectedDeleteOption}"
                                                  Width="200"
                                                  />
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding DeleteViewModel.SelectedTableData}"
                                              AutoGenerateColumns="True" SelectionMode="Single"
                                              SelectedItem="{Binding DeleteViewModel.SelectedRows}"
                                              MaxHeight="310" HorizontalAlignment="Center"  VerticalAlignment="Top" Height="291" Width="622" Margin="0,69,0,0"/>

                                    <Button Content="Delete Selected Rows" Background="Azure" FontWeight="Bold"
                                            FontSize="15" Height="35" Width="200"
                                            Command="{Binding DeleteViewModel.DeleteCommand}"
                                            HorizontalAlignment="Center" Margin="0,365,0,10" />
                                </Grid>
                            </TabItem>

                            <!--Add tab-->
                            <TabItem Header="Add Carrier" Background="#304674">
                                <Grid Background="#304674">
                                    <Label FontWeight="Medium" Margin="183,310,373,93"/>
                                    <StackPanel Margin="61,0,41,71">

                                        <!-- Input Fields for Creating a New Carrier -->
                                        <StackPanel x:Name="CarrierInputFields" Visibility="Visible">
                                            <Label Content="Company Name"/>
                                            <TextBox Text="{Binding CarrierViewModel.CompanyName}" RenderTransformOrigin="0.5,0.5" Height="22" />
                                            <Label Content="Departure City:" />
                                            <TextBox Text="{Binding CarrierViewModel.DepotCity}" />
                                            <Label Content="FLT Availability" />
                                            <TextBox Text="{Binding CarrierViewModel.Ftla}" />
                                            <Label Content="LLT Availability" />
                                            <TextBox Text="{Binding CarrierViewModel.Ltla}" />
                                            <Label Content="FLT Rate" />
                                            <TextBox Text="{Binding CarrierViewModel.FtlaRate}" />
                                            <Label Content="LTL Rate" />
                                            <TextBox Text="{Binding CarrierViewModel.LtlaRate}" />
                                            <Label Content="Reef Charge" />
                                            <TextBox Text="{Binding CarrierViewModel.ReefCharge}" />
                                        </StackPanel>
                                        <Label Content="Add new carrier" Margin="425,391,306,13" FontWeight="Bold" Foreground="AliceBlue"  RenderTransformOrigin="0.639,0.571" />
                                    </StackPanel>
                                    <Button Content="Add"  Background="Azure" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" FontSize="15" Command="{Binding CarrierViewModel.CreateCarrierCommand}" Height="60" Width="150" Margin="0,340,0,0" />


                                </Grid>
                            </TabItem>


                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- DB CONNECTION TAB -->
                <TabItem Header="DB Connection" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6">
                        <TabControl Margin="10,10,10,10">
                            <!-- Local DB Tab -->
                            <TabItem Header="Local DB" Background="#304674">
                                <!-- Local DB Tab Content -->
                            </TabItem>

                            <!-- Remote DB Tab -->
                            <TabItem Header="Remote DB" Background="#304674">
                                <!-- Remote DB Tab Content -->
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Viewbox>
</Window>