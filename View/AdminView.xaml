<Window x:Class="TMS_Project.View.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:TMS_Project.ViewModel"
        mc:Ignorable="d"
        Title="AdminView" Height="450" Width="800" WindowState="Maximized">

    <Window.DataContext>
        <viewModel:AdminViewModel />
    </Window.DataContext>

    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Grid Background="#304674" Width="887" Height="482">

            <TabControl>
                <!--HOME TAB-->
                <TabItem Header="Home" FontWeight="Medium" Background="#304674">
                    <Grid Background="#91BAD6" Height="457">
                        <!--<Grid.ColumnDefinitions>
                            <ColumnDefinition Width="106*"/>
                            <ColumnDefinition Width="775*"/>
                        </Grid.ColumnDefinitions>-->

                        <!--design-->
                        <Rectangle HorizontalAlignment="Left" Height="256" Margin="20,166,0,0" VerticalAlignment="Top" Width="468" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="100" Margin="474,322,0,0" VerticalAlignment="Top" Width="148" Fill="#304674"/>
                        <Rectangle HorizontalAlignment="Left" Height="110" Margin="474,235,0,0" VerticalAlignment="Top" Width="134" Fill="#304674" RadiusX="28.161" RadiusY="28.161"/>
                        <Rectangle HorizontalAlignment="Left" Height="60" Margin="500,262,0,0" VerticalAlignment="Top" Width="96" Fill="WHite" RadiusX="5.238" RadiusY="5.238"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="45,397,786,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="558,397,273,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="349,397,482,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="404,397,427,10"/>
                        <Ellipse Fill="#304674" Height="50" Width="50" Margin="100,397,731,10"/>

                        <!--logo-->
                        <Ellipse HorizontalAlignment="Left" Height="150" Margin="45,200,0,0" VerticalAlignment="Top" Width="200" Fill="DarkBlue"/>
                        <TextBlock HorizontalAlignment="Left" Margin="69,235,0,0" TextWrapping="Wrap" Text="TMS" VerticalAlignment="Top" Foreground="Azure" FontFamily="Times New Roman" FontSize="70" FontWeight="bold"/>



                        <Label Content="{Binding CurrentDate}" Foreground="#304674" FontSize="25" Background="#91BAD6" Margin="737,10,10,399"/>
                        <Button Content="Increment time" Command="{Binding IncrementTimeCommand}" Margin="741,58,14,373" Background="AliceBlue"/>
                        <Label Content="Welcome Admin" HorizontalAlignment="Left" Margin="55,84,0,0"
                               VerticalAlignment="Top" FontWeight="Bold" FontSize="50" Foreground="DarkBlue" />

                        <!--logs out of the user; may or may not go back to the login page-->
                        <Button Content="Log Out" Command="{Binding LogInViewModel.LogoutCommand}"
                                HorizontalAlignment="Left"
                                Margin="805,420,0,0" VerticalAlignment="Top" Height="27" Width="66"
                                Background="DarkBlue" Foreground="white" FontWeight="Medium" />
                    </Grid>
                </TabItem>

                <!--CONFIGURATIONS TAB-->
                <TabItem Header="Configurations" Background="#304674" FontWeight="Medium" Height="20"
                         VerticalAlignment="Top">
                    <Grid Background="#91BAD6">
                        <TabControl Margin="10,10,10,10">

                            <TabItem Header="Log Files" Background="#304674">
                                <Grid Background="#304674">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="121*" />
                                        <RowDefinition Height="285*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Command="{Binding FileViewModel.OpenFileBrowserCommand}"
                                            Content="Load files" Margin="10,10,758,80" Grid.ColumnSpan="2" Background="AliceBlue" FontWeight="Bold"/>
                                    <ComboBox x:Name="Folder" ItemsSource="{Binding FileViewModel.LogFiles}"
                                              SelectedItem="{Binding FileViewModel.SelectedLogFile}"
                                              Margin="102,10,133,80" Grid.Row="0" Grid.Column="1" />
                                    <TextBox VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Text="{Binding FileViewModel.FileContent}" IsReadOnly="True"
                                             Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Grid.Column="0"
                                             Margin="10,51,10,10" />
                                    <Button Command="{Binding FileViewModel.OpenSelectedFileCommand}"
                                            Content="Open selected file" Margin="727,10,10,80" Grid.Row="0"
                                            Grid.ColumnSpan="2" Grid.Column="0" Background="AliceBlue" FontWeight="Bold"/>
                                </Grid>
                            </TabItem>


                            <!-- Backup Files Tab -->
                            <TabItem Header="Backup Files" Background="#304674">
                                <Grid Background="#304674">
                                    <!-- ProgressBar -->

                                    <ListBox ItemsSource="{Binding FileViewModel.BackupFiles}" Margin="10,10,10,80"
                                             SelectedItem="{Binding FileViewModel.SelectedBackupFile}" />
                                    <Button Content="Open" Command="{Binding FileViewModel.OpenSelectedBackupCommand}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Height="38" Width="144" FontWeight="Bold" Foreground="#001233"
                                            Background="Azure" Margin="82,345,0,0" />
                                    <Label Content="Perform backup operation" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" FontWeight="Medium"
                                           Foreground="#b2cbde" Margin="0,380,100,0" />
                                    <Button Content="Backup" Command="{Binding FileViewModel.BackUpDbCommand}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Height="38" Width="144"
                                            FontWeight="Bold" Foreground="#001233" Background="Azure"
                                            Margin="606,345,0,0" />
                                    <Label Content="Open selected file" HorizontalAlignment="Left"
                                           VerticalAlignment="Top" FontWeight="Medium" Foreground="#b2cbde"
                                           Margin="100,380,0,0" />


                                    <ProgressBar x:Name="ProgressBar" Foreground="SeaGreen"
                                                 Visibility="{Binding FileViewModel.ProgressBarVisibility, Mode=OneWay}"
                                                 Margin="0,354,0,0" Height="20"
                                                 Value="{Binding FileViewModel.BackUpProgress, Mode=OneWay}"
                                                 Width="150"
                                                 VerticalAlignment="Top" HorizontalAlignment="Center" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!--ALTER DATA TAB-->
                <TabItem Header="Alter Data" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6" Height="485">
                        <TabControl Margin="10,10,10,10">

                            <!-- Route Tab -->
                            <TabItem Header="Route" Background="#304674">
                                <Grid Background="#304674" Height="438">
                                    <DataGrid Name="RouteTable" ItemsSource="{Binding RateRouteViewModel.RouteData}" Background="Azure"
                                              IsReadOnly="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Top"
                                              Width="580" Height="350" Margin="0,16,0,0" />
                                    <Button Content="Save Changes" Command="{Binding RateRouteViewModel.SaveRouteCommand}" Height="30"
                                            Width="109"
                                            Background="Azure" FontWeight="Bold" FontSize="15"
                                            VerticalAlignment="Top" HorizontalAlignment="Center"
                                            Margin="0,371,0,0" />
                                </Grid>
                            </TabItem>


                            <!-- Rates Tab -->
                            <TabItem Header="Rate" Background="#304674">
                                <Grid Background="#304674" Height="437">
                                    <DataGrid ItemsSource="{Binding RateRouteViewModel.RateData}" Background="Azure"
                                              IsReadOnly="False" HorizontalAlignment="Center" VerticalAlignment="Top" Height="366" Width="672" Margin="0,5,0,0" />
                                    <Button Content="Save" Command="{Binding RateRouteViewModel.SaveRouteCommand}" Height="31" Width="98"
                                            Background="Azure" FontWeight="Bold" FontSize="15" Margin="378,382,379,24" />
                                </Grid>
                            </TabItem>

                            <!-- Carrier Tab -->
                            <TabItem Header="Carrier" Background="#304674">
                                <Grid Background="#304674">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="109*" />
                                        <ColumnDefinition Width="679*" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid ItemsSource="{Binding CarrierViewModel.CarrierData}"
                                              Background="Azure" CanUserAddRows="False" HorizontalAlignment="Left"
                                              VerticalAlignment="Top" IsReadOnly="False" Height="353" Width="717" Margin="78,10,0,0" Grid.ColumnSpan="2" />

                                    <Button Content="Save" Command="{Binding CarrierViewModel.SaveCarrierCommand}" Background="Azure" FontWeight="Bold" FontSize="15"
                                            Grid.Column="1" Margin="251,368,368,34" />
                                </Grid>
                            </TabItem>

                            <!-- Delete Tab -->
                            <TabItem Header="Delete Data" Background="#304674">
                                <Grid Background="#304674" Height="427">
                                    <StackPanel>
                                        <Label Content="Select a table to delete from:" FontWeight="Medium"
                                               Foreground="#b2cbde"
                                               HorizontalAlignment="Center" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding DeleteViewModel.DeleteOptions}"
                                                  SelectedItem="{Binding DeleteViewModel.SelectedDeleteOption}"
                                                  Width="200" />
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding DeleteViewModel.SelectedTableData}"
                                              AutoGenerateColumns="True" SelectionMode="Single"
                                              SelectedItem="{Binding DeleteViewModel.SelectedRows}"
                                              MaxHeight="310" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Height="305" Width="614"/>

                                    <Button Content="Delete Selected Rows" Background="Azure" FontWeight="Bold"
                                            FontSize="15" Height="35" Width="200"
                                            Command="{Binding DeleteViewModel.DeleteCommand}"
                                            HorizontalAlignment="Center" Margin="0,371,0,21" />
                                </Grid>
                            </TabItem>

                            <!--Add tab-->
                            <TabItem Header="Add Carrier" Background="#304674">
                                <Grid Background="#304674" Height="428">
                                    <Label FontWeight="Medium" Margin="183,310,373,93" />
                                    <StackPanel Margin="61,0,41,71">

                                        <!-- Input Fields for Creating a New Carrier -->
                                        <StackPanel x:Name="CarrierInputFields" Visibility="Visible">
                                            <Label Content="Company Name" />
                                            <TextBox Text="{Binding CarrierViewModel.CompanyName}"
                                                     RenderTransformOrigin="0.5,0.5" Height="22" />
                                            <Label Content="Departure City:" />
                                            <TextBox Text="{Binding CarrierViewModel.DepotCity}" />
                                            <Label Content="FLT Availability" />
                                            <TextBox Text="{Binding CarrierViewModel.Ftla}" />
                                            <Label Content="LLT Availability" />
                                            <TextBox Text="{Binding CarrierViewModel.Ltla}" />
                                            <Label Content="FLT Rate" />
                                            <TextBox Text="{Binding CarrierViewModel.FtlaRate}" />
                                            <Label Content="LTL Rate" />
                                            <TextBox Text="{Binding CarrierViewModel.LtlaRate}" />
                                            <Label Content="Reef Charge" />
                                            <TextBox Text="{Binding CarrierViewModel.ReefCharge}" />
                                        </StackPanel>
                                        <Label Content="Add new carrier" Margin="425,391,306,13" FontWeight="Bold"
                                               Foreground="AliceBlue" RenderTransformOrigin="0.639,0.571" />
                                    </StackPanel>
                                    <Button Content="Add" Background="Azure" HorizontalAlignment="Center"
                                            VerticalAlignment="Top" FontWeight="Bold" FontSize="15"
                                            Command="{Binding CarrierViewModel.CreateCarrierCommand}" Height="60"
                                            Width="150" Margin="0,349,0,0" />
                                </Grid>
                            </TabItem>


                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- DB CONNECTION TAB -->
                <TabItem Header="DB Connection" Background="#304674" FontWeight="Medium">
                    <Grid Background="#91BAD6">
                        <TabControl Margin="10,10,10,10">
                            <!-- Local DB Tab -->
                            <TabItem Header="Local DB" Background="#304674">
                                <!-- Local DB Tab Content -->
                                <StackPanel Margin="10">
                                    <TextBlock Text="Local DB Settings" Foreground="White" Margin="0,0,0,10" />
                                </StackPanel>
                            </TabItem>

                            <!-- Remote DB Tab -->
                            <TabItem Header="Remote DB" Background="#304674">
                                <!-- Remote DB Tab Content -->
                                <StackPanel Margin="10">
                                    <TextBlock Text="Remote DB Settings" Foreground="White" Margin="0,0,0,10" />
                                    <Label Content="Server" />
                                    <TextBox x:Name="RemoteDbServerTextBox" Margin="0,0,0,10" />
                                    <Label Content="Port" />
                                    <TextBox x:Name="RemoteDbPortTextBox" Margin="0,0,0,10" />
                                    <Label Content="Database" />
                                    <TextBox x:Name="RemoteDbNameTextBox" Margin="0,0,0,10" />
                                    <Label Content="Username" />
                                    <TextBox x:Name="RemoteDbUsernameTextBox" Margin="0,0,0,10" />
                                    <Label Content="Password" />
                                    <TextBox x:Name="RemoteDbPasswordBox" Margin="0,0,0,10" />
                                    <Button Content="Test Connection" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Viewbox>
</Window>